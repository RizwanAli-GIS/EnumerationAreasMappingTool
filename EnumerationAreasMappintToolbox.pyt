# -*- coding: utf-8 -*-import arcpyimport osclass Toolbox:    def __init__(self):        """Define the toolbox (the name of the toolbox is the name of the        .pyt file)."""        self.label = "Toolbox"        self.alias = "toolbox"        # List of tool classes associated with this toolbox        self.tools = [Tool]class Tool:    def __init__(self):        """Define the tool (tool name is the name of the class)."""        self.label = "Tool"        self.description = ""    def getParameterInfo(self):        """Define the tool parameters."""        # 1. Admin boundary (polygon)        admin_fc = arcpy.Parameter(            displayName="Admin Boundary",            name="admin_fc",            datatype="GPFeatureLayer",            parameterType="Required",            direction="Input"        )	# 2. Hierarchy feature classes (ORDERED, multi-value)        hierarchy_fcs = arcpy.Parameter(            displayName="Hierarchy Feature Classes (ordered)",            name="hierarchy_fcs",            datatype="GPFeatureLayer",            parameterType="Required",            direction="Input",            multiValue=True        )	# 3. Point layer        points_fc = arcpy.Parameter(            displayName="Point Layer",            name="points_fc",            datatype="GPFeatureLayer",            parameterType="Required",            direction="Input"        )        # 4. Analysis field (numeric)        analysis_field = arcpy.Parameter(            displayName="Analysis Field (numeric)",            name="analysis_field",            datatype="Field",            parameterType="Required",            direction="Input"        )        analysis_field.parameterDependencies = [points_fc.name]        # 5. Minimum value        min_val = arcpy.Parameter(            displayName="Minimum Value",            name="min_val",            datatype="GPLong",            parameterType="Required",            direction="Input"        )        # 6. Maximum value        max_val = arcpy.Parameter(            displayName="Maximum Value",            name="max_val",            datatype="GPLong",            parameterType="Required",            direction="Input"        )        # 7. Output feature class        output_fc = arcpy.Parameter(            displayName="Output Feature Class",            name="output_fc",            datatype="DEFeatureClass",            parameterType="Required",            direction="Output"        )        return [admin_fc, hierarchy_fcs, points_fc,                analysis_field, min_val, max_val, output_fc]    def isLicensed(self):        """Set whether the tool is licensed to execute."""        return True    def updateParameters(self, parameters):        """Modify the values and properties of parameters before internal        validation is performed.  This method is called whenever a parameter        has been changed."""        return    def updateMessages(self, parameters):        """Modify the messages created by internal validation for each tool        parameter. This method is called after internal validation."""        return    # --- Helper function: calculate HH_SUM using FieldMappings ---    def calc_hh(self, in_fc, out_fc, points_fc, analysis_field):        if arcpy.Exists(out_fc):            arcpy.management.Delete(out_fc)        # --- Remove existing HH_SUM if present ---        in_fields = [f.name.upper() for f in arcpy.ListFields(in_fc)]        if "HH_SUM" in in_fields:            arcpy.management.DeleteField(in_fc, "HH_SUM")                fm = arcpy.FieldMappings()        fm.addTable(points_fc)        field_map = arcpy.FieldMap()        field_map.addInputField(points_fc, analysis_field)        field_map.mergeRule = "Sum"        out_field = field_map.outputField        out_field.name = "HH_SUM"        out_field.aliasName = "HH_SUM"        field_map.outputField = out_field        fm.addFieldMap(field_map)        arcpy.analysis.SpatialJoin(            target_features=in_fc,            join_features=points_fc,            out_feature_class=out_fc,            join_operation="JOIN_ONE_TO_ONE",            join_type="KEEP_ALL",            field_mapping=fm,            match_option="INTERSECT"        )        # Replace NULL HH_SUM with 0        arcpy.management.CalculateField(            in_table=out_fc,            field="HH_SUM",            expression="0 if !HH_SUM! is None else !HH_SUM!",            expression_type="PYTHON3"        )        return out_fc    # --- Helper function: run SC-MVC clustering ---    def run_sc_mvc(self, input_fc, min_c, max_c, oid, messages_prefix=""):        min_max_adjusted = False        while True:            try:                Cluster_Features = f"in_memory\\Clusters_{oid}"                if arcpy.Exists(Cluster_Features):                    arcpy.management.Delete(Cluster_Features)                arcpy.management.RepairGeometry(input_fc)                arcpy.stats.SpatiallyConstrainedMultivariateClustering(                    in_features=input_fc,                    output_features=Cluster_Features,                    analysis_fields=["HH_SUM"],                    size_constraints="ATTRIBUTE_VALUE",                    constraint_field="HH_SUM",                    min_constraint=min_c,                    max_constraint=max_c,                    spatial_constraints="CONTIGUITY_EDGES_ONLY",                    number_of_permutations=0,                    output_table=""                )                Dissolved_Clusters = f"in_memory\\Dissolved_Clusters_{oid}"                if arcpy.Exists(Dissolved_Clusters):                    arcpy.management.Delete(Dissolved_Clusters)                arcpy.management.Dissolve(                    in_features=Cluster_Features,                    out_feature_class=Dissolved_Clusters,                    dissolve_field=["CLUSTER_ID"],                    statistics_fields=[["HH_SUM", "SUM"]],                    multi_part="SINGLE_PART",                    unsplit_lines="DISSOLVE_LINES"                )                if "SUM_HH_SUM" in [f.name for f in arcpy.ListFields(Dissolved_Clusters)]:                    arcpy.management.AlterField(Dissolved_Clusters, "SUM_HH_SUM", "HH_SUM", "HH_SUM")                arcpy.management.RepairGeometry(Dissolved_Clusters)                arcpy.AddMessage(f"Clustering done for admin ID {oid}")                return Dissolved_Clusters            except arcpy.ExecuteError:                counts = [r[0] for r in arcpy.da.SearchCursor(input_fc, ["HH_SUM"]) if r[0] is not None]                if not counts:                    return input_fc                if not min_max_adjusted:                    arcpy.AddWarning(f"available max: {max(counts)}, suma of all available features: {sum(counts)}")                    new_max_c = int(max_c*1.05)                    if new_max_c < sum(counts):                        max_c = new_max_c                    else:                        max_c = sum(counts) # assigned maximum value                        new_min_c = int(min_c*0.95)                        if new_min_c > max(counts):                            min_c = new_min_c                        else:                            min_c = max(counts)                            min_max_adjusted = True                    arcpy.AddWarning(f"{messages_prefix} Adjusting constraints for admin {oid}: min={min_c}, max={max_c}")                    continue # 🔁 TRY CLUSTERING AGAIN WITH NEW CONSTRAINTS                else:                    try:                        # merge zero-HH polygons                        zero_layer = "zero_hh_layer"                        arcpy.MakeFeatureLayer_management(input_fc, zero_layer)                        arcpy.SelectLayerByAttribute_management(zero_layer, "NEW_SELECTION", "HH_SUM = 0")                        if int(arcpy.management.GetCount(zero_layer)[0]) > 0:                            eliminated_fc = f"in_memory\\Elim_{oid}"                            arcpy.management.Eliminate(                                in_features=zero_layer,                                out_feature_class=eliminated_fc,                                selection="LENGTH",                                ex_where_clause="",                                ex_features=None                            )                            input_fc = eliminated_fc                        arcpy.AddWarning("Custering failed even after adjusting constraints. Returning input features after eliminating 0 values.")                        return input_fc                    except arcpy.ExecuteError:                        arcpy.AddWarning("Clustering failed even after adjusting constraints. Returning input features.")                        return input_fc    def execute(self, parameters, messages):        admin_fc = parameters[0].valueAsText        hierarchy_fcs = parameters[1].valueAsText.split(";")  # ordered list        points_fc = parameters[2].valueAsText        analysis_field = parameters[3].valueAsText        min_val = int(parameters[4].value)        max_val = int(parameters[5].value)        output_fc = parameters[6].valueAsText        arcpy.env.overwriteOutput = True                # Delete output if exists        if arcpy.Exists(output_fc):            arcpy.management.Delete(output_fc)        out_path = os.path.dirname(output_fc)        out_name = os.path.basename(output_fc)        arcpy.management.CreateFeatureclass(            out_path=out_path,            out_name=out_name,            geometry_type="POLYGON",            template=admin_fc,            spatial_reference=admin_fc        )        if "HH_SUM" not in [f.name for f in arcpy.ListFields(output_fc)]:            arcpy.management.AddField(output_fc, "HH_SUM", "DOUBLE")        total_admins = int(arcpy.management.GetCount(admin_fc)[0])        arcpy.SetProgressor("step", "Processing admin polygons...", 0, total_admins, 1)        counter = 0        with arcpy.da.SearchCursor(admin_fc, ["SHAPE@", "OID@"]) as cursor:            for geom, oid in cursor:                counter += 1                arcpy.SetProgressorLabel(f"Processing admin polygon {counter} of {total_admins} (ID {oid})")                arcpy.SetProgressorPosition()                arcpy.AddMessage(f"Processing admin polygon ID {oid}")                temp_poly = f"in_memory\\poly_{oid}"                if arcpy.Exists(temp_poly):                    arcpy.management.Delete(temp_poly)                arcpy.management.CopyFeatures([geom], temp_poly)                # Calculate HH_SUM                sj_fc = f"in_memory\\sj_{oid}"                self.calc_hh(temp_poly, sj_fc, points_fc, analysis_field)                sum_value = sum(r[0] or 0 for r in arcpy.da.SearchCursor(sj_fc, ["HH_SUM"]))                arcpy.AddMessage(f"Total HH_SUM for admin ID {oid}: {sum_value}")                # If below max → append as-is                if sum_value <= max_val:                    arcpy.management.Append(sj_fc, output_fc, "NO_TEST")                    arcpy.AddMessage("Admin polygon added as-is, no split required.")                    continue                current_fc = sj_fc                # clipping splitter for each admin                hierarchy_fcs_clipped = []                for level_index, split_fc in enumerate(hierarchy_fcs):                    geom_type = arcpy.Describe(split_fc).shapeType                    splitter_clipped_admin = f"in_memory\\SplitterAdmin_{oid}_{level_index}"                    if arcpy.Exists(splitter_clipped_admin):                        arcpy.management.Delete(splitter_clipped_admin)                    # Clip splitter to admin                    arcpy.analysis.Clip(split_fc, temp_poly, splitter_clipped_admin)                    # Process splitter: Polyline → polygons; Polygon → Thiessen                    if geom_type == "Polyline":                        singlepart_fc = f"in_memory\\Singlepart_{oid}_{level_index}"                        if arcpy.Exists(singlepart_fc):                            arcpy.management.Delete(singlepart_fc)                        arcpy.management.MultipartToSinglepart(splitter_clipped_admin, singlepart_fc)                        hierarchy_fcs_clipped.append(singlepart_fc)                    else:                        centroid_splitter = f"in_memory\\Centroid_{oid}_{level_index}"                        thiessen = f"in_memory\\Thiessen_{oid}_{level_index}"                        clipped_thiessen = f"in_memory\\ThiessenClip_{oid}_{level_index}"                        singlepart_fc = f"in_memory\\Singlepart_{oid}_{level_index}"                        for fc in [centroid_splitter, thiessen, clipped_thiessen, singlepart_fc]:                            if arcpy.Exists(fc):                                arcpy.management.Delete(fc)                        arcpy.management.FeatureToPoint(splitter_clipped_admin, centroid_splitter, "INSIDE")                        arcpy.analysis.CreateThiessenPolygons(centroid_splitter, thiessen, "ALL")                        arcpy.analysis.Clip(thiessen, temp_poly, clipped_thiessen)                        arcpy.management.MultipartToSinglepart(clipped_thiessen, singlepart_fc)                        hierarchy_fcs_clipped.append(singlepart_fc)                # --- Hierarchically Splitting loop ---                process_splitter_single_or_all = "single"                if process_splitter_single_or_all == "single":                    for level_index, split_fc in enumerate(hierarchy_fcs_clipped):                        arcpy.AddMessage(f"Splitting admin {oid} using splitter level {level_index}")                        high_fc = f"in_memory\\High_{oid}_{level_index}"                        low_fc = f"in_memory\\Low_{oid}_{level_index}"                        split_poly = f"in_memory\\SplitPoly_{oid}_{level_index}"                        merged_fc = f"in_memory\\Merged_{oid}_{level_index}"                        recalc_fc = f"in_memory\\Recalc_{oid}_{level_index}"                        for fc in [high_fc, low_fc, split_poly, merged_fc, recalc_fc]:                            if arcpy.Exists(fc):                                arcpy.management.Delete(fc)                        # --- 1. Separate HIGH and LOW ---                        arcpy.management.MakeFeatureLayer(current_fc, "cur_lyr")                        arcpy.management.SelectLayerByAttribute("cur_lyr", "NEW_SELECTION", f"HH_SUM > {max_val}")                        arcpy.management.CopyFeatures("cur_lyr", high_fc)                        arcpy.management.SelectLayerByAttribute("cur_lyr", "SWITCH_SELECTION")                        arcpy.management.CopyFeatures("cur_lyr", low_fc)                        if int(arcpy.management.GetCount(high_fc)[0]) == 0:                            arcpy.AddMessage("No high HH_SUM areas, skipping this splitter.")                            current_fc = current_fc                            continue                        # --- 2. Split ONLY high_fc ---                        geom_type = arcpy.Describe(split_fc).shapeType                        if geom_type == "Polyline":                            ftp = f"in_memory\\FTP_{oid}_{level_index}"                            if arcpy.Exists(ftp):                                arcpy.management.Delete(ftp)                            arcpy.management.FeatureToPolygon([high_fc, split_fc], ftp)                            arcpy.management.MultipartToSinglepart(ftp, split_poly)                        else:  # Polygon splitter                            intersect_fc = f"in_memory\\Intersect_{oid}_{level_index}"                            if arcpy.Exists(intersect_fc):                                arcpy.management.Delete(intersect_fc)                            arcpy.analysis.Intersect([high_fc, split_fc], intersect_fc)                            arcpy.management.MultipartToSinglepart(intersect_fc, split_poly)                        # --- 3. Merge LOW + SPLIT HIGH ---                        parts = []                        if int(arcpy.management.GetCount(split_poly)[0]) > 0:                            parts.append(split_poly)                        if int(arcpy.management.GetCount(low_fc)[0]) > 0:                            parts.append(low_fc)                        arcpy.management.Merge(parts, merged_fc)                        # --- 4. Recalculate HH_SUM ---                        self.calc_hh(merged_fc, recalc_fc, points_fc, analysis_field)                        # --- 5. Feed to next splitter ---                        current_fc = recalc_fc                elif process_splitter_single_or_all == "all":                    #hierarchy_fcs_clipped.append(singlepart_fc)                    arcpy.management.FeatureToPolygon(hierarchy_fcs_clipped, current_fc)                # ✅ before cluster ensure the full coverage of admin boundary by union                union_features_admin = f"in_memory\\union_features_{oid}"                arcpy.analysis.Union(                    in_features=[current_fc,temp_poly],                    out_feature_class=union_features_admin,                    join_attributes="ALL",                    cluster_tolerance=None,                    gaps="GAPS"                )                union_singlepart_admin = f"in_memory\\union_singlepart_{oid}"                arcpy.management.MultipartToSinglepart(union_features_admin, union_singlepart_admin)                self.calc_hh(union_singlepart_admin, current_fc, points_fc, analysis_field)                # ✅ AFTER ALL SPLITS → CLUSTER                clustered_fc = self.run_sc_mvc(                    current_fc,                    min_val, max_val,                    oid,                    messages_prefix=f"[Admin {oid}]"                )                # ✅ FINAL OUTPUT = CLUSTER ONLY                arcpy.management.Append(clustered_fc, output_fc, "NO_TEST")                arcpy.AddMessage(f"Finished admin {oid}")############################################################################################################        arcpy.ResetProgressor()        arcpy.AddMessage("Processing complete.")    def postExecute(self, parameters):        """This method takes place after outputs are processed and        added to the display."""        return